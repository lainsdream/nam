;; таймер как в оригинальном fscroller-скрипте (delay=100 в исходном JS) --
;; смена кадра каждые 100мс, зацикленно. r/atom, а не обычный atom, чтобы
;; ре-рендер срабатывал автоматически при каждом тике.
(defonce bg-frame-idx (r/atom 0))

;; фон на весь экран (fixed, за содержимым app -- см. .ascii-bg { z-index: 0 }
;; и #app { z-index: 1 } в index.html), кликов/тапов не перехватывает
;; (pointer-events: none в CSS), поэтому не мешает работе интерфейса
(defn bg []
  [:pre.ascii-bg (nth bg-frames @bg-frame-idx)])

(defonce bg-timer
  (js/setInterval
    #(swap! bg-frame-idx (fn [i] (mod (inc i) (count bg-frames))))
    100))
