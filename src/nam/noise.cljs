(ns nam.noise)

;; отдельный, более широкий набор глифов для статичного шума
;; нерасшифрованного пакета -- decay-glyphs (3 штуки) не трогаем, они
;; жёстко завязаны на 3 стадии волны распада в decay-char
(def glyphs ["▓" "▒" "░" "▚" "▞" "▙" "▟" "▄" "▀" "█"])

;; кэш сгенерированного шума по seed (hash ciphertext) -- не r/atom,
;; чтобы не тянуть за собой лишние ре-рендеры; нужен только чтобы шум
;; одного и того же пакета не перегенерировался на каждый рендер
(defonce cache (atom {}))

;; настоящий случайный шум для signed-пакета, для которого ещё нет
;; decrypted -- берём более широкий noise-glyphs (не decay-glyphs, у
;; того особая роль в волне). Генерируем один раз через rand-nth и
;; кэшируем по seed (hash ciphertext) в noise-cache, чтобы у одного и
;; того же пакета шум не перерисовывался/мерцал на каждый ре-рендер, но
;; при этом реально не совпадал ни с каким предсказуемым паттерном.
(defn line [seed len]
  (or (get @cache [seed len])
      (let [line (apply str (repeatedly len #(rand-nth glyphs)))]
        (swap! cache assoc [seed len] line)
        line)))
